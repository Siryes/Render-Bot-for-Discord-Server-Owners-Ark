@bot.event
async def on_raw_reaction_add(payload: discord.RawReactionActionEvent):
  if payload.user_id == bot.user.id:
    return

  if str(payload.emoji) in TRIGGER_EMOJIS:
    channel = bot.get_channel(payload.channel_id)
    if not channel:
      return

    try:
      message = await channel.fetch_message(payload.message_id)
      user = await bot.fetch_user(payload.user_id)

      if not message.embeds:
        return

      matched_config = None
      for map_key, config in BASE_CONFIGS.items():
        if not config.get("active", True):
          continue
        if config.get("message_id") == message.id:
          matched_config = config
          break

      if not matched_config:
        existing_embed = message.embeds[0]
        embed_title = (
            existing_embed.title.lower() if existing_embed.title else ""
        )
        for map_key, config in BASE_CONFIGS.items():
          if not config.get("active", True):
            continue
          if (
              map_key in embed_title
              or config["title"].lower() in embed_title
          ):
            matched_config = config
            break

      if not matched_config:
        return

      matched_config["message_id"] = message.id
      matched_config["channel_id"] = channel.id

      new_embed = build_card_embed(matched_config, user.mention)

      await message.edit(embed=new_embed)
      await message.remove_reaction(payload.emoji, user)

    except Exception as e:
      print(f"Error processing reaction: {e}")


