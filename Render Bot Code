def build_card_embed(config: dict, user_mention: str) -> discord.Embed:
  tier_key = config["tier"]
  render_days = MATERIAL_TIERS[tier_key]
  server_num = config.get("server", "N/A")

  now = datetime.datetime.now(datetime.timezone.utc)
  render_time_unix = int(now.timestamp())
  next_render_unix = int((now + datetime.timedelta(days=render_days)).timestamp())

  config["last_render_time"] = now
  config["alert_sent"] = False

  embed = discord.Embed(
      title=config["title"],
      color=discord.Color.green(),
  )
  embed.add_field(name="Server", value=f"`{server_num}`", inline=True)
  embed.add_field(name="Last Rendered By", value=user_mention, inline=True)
  embed.add_field(
      name="Rendered At", value=f"<t:{render_time_unix}:F>", inline=False
  )
  embed.add_field(
      name="Next Render Due",
      value=f"<t:{next_render_unix}:R> (<t:{next_render_unix}:F>)",
      inline=False,
  )
  embed.set_image(url=config["image"])
  embed.set_footer(
      text=(
          f"Material: {tier_key.upper()} | Timer set for {render_days} days.\n"
          "⚠️ Dinos will decay in 9 days if left out"
      )
  )
  return embed


@bot.event
async def on_ready():
  print(f"Logged in as {bot.user}!")

  try:
    if GUILD_ID != 123456789012345678:
      guild = discord.Object(id=GUILD_ID)
      bot.tree.copy_global_to(guild=guild)
      synced = await bot.tree.sync(guild=guild)
      print(
          f"Instantly synced {len(synced)} slash command(s) to server"
          f" {GUILD_ID}!"
      )
    else:
      synced = await bot.tree.sync()
      print(f"Synced {len(synced)} slash command(s) globally.")
  except Exception as e:
    print(f"Failed to sync slash commands: {e}")

  if not check_decay_timers.is_running():
    check_decay_timers.start()


# ------------------------------------------------------------------
# BACKGROUND DECAY CHECKER
# ------------------------------------------------------------------
@tasks.loop(hours=1)
async def check_decay_timers():
  now = datetime.datetime.now(datetime.timezone.utc)

  for map_key, config in BASE_CONFIGS.items():
    if not config.get("active", True):
      continue

    last_render = config.get("last_render_time")
    channel_id = config.get("channel_id")
    alert_sent = config.get("alert_sent", False)

    if last_render and channel_id and not alert_sent:
      tier_days = MATERIAL_TIERS[config["tier"]]
      due_date = last_render + datetime.timedelta(days=tier_days)
      time_left = due_date - now

      if time_left < datetime.timedelta(days=2):
        channel = bot.get_channel(channel_id)
        if channel:
          map_title = config["title"].replace("🏰 Base Render Status: ", "")
          server_num = config.get("server", "N/A")
          await channel.send(
              f"🚨 **@admin** Decay timer up for **{map_title}** (Server:"
              f" `{server_num}`)!"
          )
          config["alert_sent"] = True


