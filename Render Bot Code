@bot.tree.command(
    name="setupbases",
    description="Posts active map cards into the current channel.",
)
async def setup_bases(interaction: discord.Interaction):
  await interaction.response.send_message(
      "Setting up active base cards...", ephemeral=True
  )
  for key, config in BASE_CONFIGS.items():
    if not config.get("active", True):
      continue

    embed = build_card_embed(config, interaction.user.mention)
    msg = await interaction.channel.send(embed=embed)
    await msg.add_reaction("🦖")

    config["message_id"] = msg.id
    config["channel_id"] = interaction.channel_id


@bot.tree.command(
    name="removemap",
    description="Deletes a card from the channel and hides it from setup.",
)
@app_commands.choices(map_name=MAP_CHOICES)
async def remove_map(
    interaction: discord.Interaction, map_name: app_commands.Choice[str]
):
  map_key = map_name.value
  config = BASE_CONFIGS.get(map_key)

  if not config:
    await interaction.response.send_message("Map not found.", ephemeral=True)
    return

  config["active"] = False

  if config.get("message_id") and config.get("channel_id"):
    try:
      channel = bot.get_channel(config["channel_id"])
      if channel:
        msg = await channel.fetch_message(config["message_id"])
        await msg.delete()
    except Exception as e:
      print(f"Could not delete message for {map_key}: {e}")

    config["message_id"] = None
    config["channel_id"] = None

  await interaction.response.send_message(
      f"❌ **{map_name.name}** has been deactivated and removed.", ephemeral=True
  )


